# Copy to `.dev.vars` for local development. `.dev.vars` is gitignored.
#
# --- Phase 3: Progress Agent / Workers AI ---
#
# Workers AI has no offline local runtime. `wrangler dev` proxies env.AI to the
# real Workers AI service, which needs auth: run `wrangler login` once, or set
# CLOUDFLARE_API_TOKEN. The free plan includes 10,000 Neurons/day.
#
# To develop WITHOUT Cloudflare credentials, set this to 1:
#   - the agent returns a deterministic answer from the real workspace context
#     instead of calling a model
#   - RAG retrieval is skipped (retrievedHistory: 0)
#   - the history-index queue consumer no-ops (producer -> consumer wiring still runs)
# Set to 0 (needs `wrangler login`) to use the real model + real Vectorize index.
AGENT_FAKE_AI=1

# Optional: override the Workers AI model ids (defaults set in wrangler.jsonc).
# PROGRESS_AGENT_MODEL="@cf/meta/llama-3.1-8b-instruct-fast"
# HISTORY_EMBED_MODEL="@cf/baai/bge-base-en-v1.5"   # 768-dim; must match the Vectorize index

# --- Phase 4B: Workflow timing (read inside the workflow run(); NOT production values) ---
# Use short values locally so blocker reminder/escalation tests run in seconds.
# Duration strings: "<n> seconds|minutes|hours|days".
BLOCKER_REMINDER_DELAY=3 seconds
BLOCKER_ESCALATION_DELAY=20 seconds
WEEKLY_STEP_TIMEOUT=120 seconds
WEEKLY_MAX_ROUNDS=3
