{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "internpulse",
  "main": "src/worker/index.ts",
  // Bumped for Phase 4B: step.waitForEvent (human-in-the-loop Workflows) needs a
  // post-May-2025 runtime.
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Workers AI is the inference layer for the Progress Agent (Phase 3).
  // No local emulation: `wrangler dev` proxies this to real Workers AI and needs
  // `wrangler login` / CLOUDFLARE_API_TOKEN. Set AGENT_FAKE_AI=1 in .dev.vars to
  // run the agent fully offline with a deterministic, context-grounded stub.
  "ai": { "binding": "AI" },

  "vars": {
    // Overridable Workers AI model id for the Progress Agent.
    "PROGRESS_AGENT_MODEL": "@cf/meta/llama-3.1-8b-instruct-fast",
    // "1" => skip real inference AND skip RAG (Vectorize). The agent returns a
    // deterministic grounded stub and the history-index queue consumer no-ops.
    // Real value belongs in .dev.vars (gitignored); this default keeps it typed.
    "AGENT_FAKE_AI": "",
    // Workers AI embedding model for the Phase 4A history index. Its output
    // dimension (768) is locked into the Vectorize index at creation time.
    "HISTORY_EMBED_MODEL": "@cf/baai/bge-base-en-v1.5",

    // Phase 4B workflow timing — read INSIDE the workflow run() so timing is
    // config-driven, never baked in. Production values are not locked this phase.
    // Override with short values in .dev.vars for fast local tests.
    "BLOCKER_REMINDER_DELAY": "1 hour",
    "BLOCKER_ESCALATION_DELAY": "1 day",
    // Shorter delays used when the blocker's linked task is URGENT/HIGH priority.
    "BLOCKER_REMINDER_DELAY_URGENT": "15 minutes",
    "BLOCKER_ESCALATION_DELAY_URGENT": "1 hour",
    "WEEKLY_STEP_TIMEOUT": "3 days",
    "WEEKLY_MAX_ROUNDS": "3"
  },

  // Phase 4A: long-term retrieval memory. Vectorize is retrieval ONLY, never a
  // source of truth. `remote: true` because Vectorize has no local emulation —
  // `wrangler dev` talks to the real index over your `wrangler login`.
  "vectorize": [
    { "binding": "VECTORIZE", "index_name": "internpulse-history", "remote": true }
  ],

  // Stage 1 (finish): R2 stores original uploaded files ONLY. Attachment
  // metadata is workspace-local (DO SQLite); searchable text chunks live in
  // Vectorize. R2 emulates in `wrangler dev`; for deploy:
  //   wrangler r2 bucket create internpulse-attachments
  "r2_buckets": [
    { "binding": "ATTACHMENTS", "bucket_name": "internpulse-attachments" }
  ],

  // A mutation to an UPDATE / BLOCKER / FEEDBACK enqueues a compact reference
  // event; the consumer re-reads the authoritative entity from WorkspaceDO,
  // embeds it, and upserts into Vectorize. Queues run fully locally in
  // `wrangler dev` (no provisioning needed until `wrangler deploy`).
  "queues": {
    "producers": [
      { "binding": "HISTORY_QUEUE", "queue": "internpulse-history-index" },
      // Phase 4B: async hand-off for starting durable Workflows from the DO
      // mutation path without blocking the ack.
      { "binding": "WORKFLOW_QUEUE", "queue": "internpulse-workflow-events" }
    ],
    "consumers": [
      {
        "queue": "internpulse-history-index",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3
      },
      {
        "queue": "internpulse-workflow-events",
        "max_batch_size": 5,
        "max_batch_timeout": 2,
        "max_retries": 3
      }
    ]
  },

  // Phase 4B: long-running human-in-the-loop processes. Blocker reminder/
  // escalation, and the weekly progress review. Classes are exported from
  // src/worker/index.ts; Workflows run locally in `wrangler dev`.
  "workflows": [
    {
      "name": "internpulse-blocker",
      "binding": "BLOCKER_WORKFLOW",
      "class_name": "BlockerWorkflow"
    },
    {
      "name": "internpulse-weekly",
      "binding": "WEEKLY_WORKFLOW",
      "class_name": "WeeklyReviewWorkflow"
    }
  ],

  // React SPA is built to dist/client and served by the Workers assets runtime.
  // Unknown paths fall back to index.html so client-side routing works later.
  "assets": {
    "not_found_handling": "single-page-application"
  },

  // One Durable Object instance per internship/project workspace.
  // Routed by `idFromName(workspaceId)` in the Worker, so workspace-123 always
  // maps to the same DO. SQLite-backed (see migrations below).
  // One WorkspaceDO per workspace (authoritative state) + one ProgressAgent per
  // workspace (stateful AI, Agents SDK). Both keyed by the workspace id.
  "durable_objects": {
    "bindings": [
      { "name": "WORKSPACE_DO", "class_name": "WorkspaceDO" },
      { "name": "PROGRESS_AGENT", "class_name": "ProgressAgent" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["WorkspaceDO"] },
    { "tag": "v2", "new_sqlite_classes": ["ProgressAgent"] }
  ],

  // Organization-wide relational data (users, teams, workspaces, memberships).
  // Local dev uses a simulated DB; `database_id` is the real one created with
  // `wrangler d1 create internpulse` (used by `--remote` / deploy).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "internpulse",
      "database_id": "9760acc5-31e9-49f1-bb9f-773ed8096cfe",
      "migrations_dir": "migrations"
    }
  ]
}
